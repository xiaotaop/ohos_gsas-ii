set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_C_COMPILER /usr/bin/clang-20)
set(CMAKE_CXX_COMPILER /usr/bin/clang++-20)
set(CMAKE_C_COMPILER_TARGET aarch64-linux-ohos)
set(CMAKE_CXX_COMPILER_TARGET aarch64-linux-ohos)
set(CMAKE_SYSROOT /work/sdk/sysroot)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_C_FLAGS_INIT "-fPIC")
set(CMAKE_CXX_FLAGS_INIT "-fPIC -nostdinc++ -isystem /work/sdk/include/c++/v1")
set(CMAKE_AR /usr/bin/llvm-ar-20)
set(CMAKE_RANLIB /usr/bin/llvm-ranlib-20)
