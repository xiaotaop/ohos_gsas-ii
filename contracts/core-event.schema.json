{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ohos-gsas-ii/core-event.schema.json",
  "title": "GSAS-II HarmonyOS Core Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "eventId", "jobId", "sequence", "timestamp", "type", "payload"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "eventId": { "type": "string", "pattern": "^evt_[A-Za-z0-9_-]{8,80}$" },
    "jobId": { "type": "string", "pattern": "^job_[A-Za-z0-9_-]{8,64}$" },
    "sequence": { "type": "integer", "minimum": 0 },
    "timestamp": { "type": "string", "format": "date-time" },
    "type": {
      "enum": ["job.accepted", "job.progress", "job.log", "job.completed", "job.failed", "job.cancelled"]
    },
    "payload": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "job.accepted" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/acceptedPayload" } } }
    },
    {
      "if": { "properties": { "type": { "const": "job.progress" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/progressPayload" } } }
    },
    {
      "if": { "properties": { "type": { "const": "job.log" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/logPayload" } } }
    },
    {
      "if": { "properties": { "type": { "const": "job.completed" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/completedPayload" } } }
    },
    {
      "if": { "properties": { "type": { "const": "job.failed" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/failedPayload" } } }
    },
    {
      "if": { "properties": { "type": { "const": "job.cancelled" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/cancelledPayload" } } }
    }
  ],
  "$defs": {
    "acceptedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": { "state": { "const": "queued" } }
    },
    "progressPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "stage", "stageIndex", "stageCount", "percent", "message"],
      "properties": {
        "state": { "enum": ["validating", "running", "saving", "cancelling"] },
        "stage": { "type": "string", "minLength": 1, "maxLength": 80 },
        "stageIndex": { "type": "integer", "minimum": 0 },
        "stageCount": { "type": "integer", "minimum": 1 },
        "percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "message": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "logPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "source", "message"],
      "properties": {
        "level": { "enum": ["debug", "info", "warning", "error"] },
        "source": { "enum": ["core", "python", "gsas-ii", "file-service"] },
        "message": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "completedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "result"],
      "properties": {
        "state": { "const": "succeeded" },
        "result": { "$ref": "#/$defs/result" }
      }
    },
    "failedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "error"],
      "properties": {
        "state": { "const": "failed" },
        "error": { "$ref": "#/$defs/error" }
      }
    },
    "cancelledPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reason"],
      "properties": {
        "state": { "const": "cancelled" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recipeId", "upstreamCommit", "elapsedSeconds", "stages", "artifacts"],
      "properties": {
        "recipeId": { "type": "string", "minLength": 1 },
        "upstreamCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "elapsedSeconds": { "type": "number", "minimum": 0 },
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/stageResult" }
        },
        "preferredOrientation": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["performed", "passed"],
          "properties": {
            "performed": { "type": "boolean" },
            "passed": { "type": ["boolean", "null"] }
          }
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifact" }
        }
      }
    },
    "stageResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "rwpByHistogram"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "rwpByHistogram": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "number", "minimum": 0 }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileId", "kind", "displayName", "mediaType"],
      "properties": {
        "fileId": { "type": "string", "pattern": "^file_[A-Za-z0-9_-]{8,64}$" },
        "kind": { "enum": ["project", "result", "log"] },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "mediaType": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
        "message": { "type": "string", "minLength": 1, "maxLength": 500 },
        "retryable": { "type": "boolean" },
        "detail": { "type": "string", "maxLength": 2000 }
      }
    }
  }
}
